# ==========================================
# INCLUSIVE ALLOWLIST GITIGNORE
# ==========================================

# 1. Ignore everything by default
*

# 2. Prevent ignoring directory paths so Git can traverse subfolders
!*/
!**/

# 3. Explicitly allow configuration files in root
!.gitignore
!package.json
!package-lock.json
!tsconfig.json
!README.md

# 4. Explicitly allow backend files
!backend/
!backend/package.json
!backend/package-lock.json
!backend/tsconfig.json
!backend/ecosystem.config.js
!backend/prisma/
!backend/prisma/**
!backend/src/
!backend/src/**

# 5. Explicitly allow frontend files
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/public/
!frontend/public/**
!frontend/src/
!frontend/src/**
!frontend/postcss.config.js
!frontend/tailwind.config.js

# ==========================================
# EXCLUSION FOR ALLOWLIST EXEMPTIONS
# (Re-ignore build artifacts, secrets & logs)
# ==========================================
**/node_modules/
**/dist/
**/.env
**/.env.*
**/logs/
**/*.log
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
